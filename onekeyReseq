#!/usr/bin/env bash

curTime(){
	echo $(date +"%Y-%m-%d %H:%M:%S")
}

function checkfile()
{
ctime=$(curTime)
if [ ! -f $1 ];then
printf "[ERROR] $ctime: 未发现文件:\t$1\n"
flag=1
fi
}

if [ $# -eq 0 ]; then
	work_dir="."
	work_dir=$(realpath $work_dir)
	echo -e "使用当前文件夹作为工作目录\n$work_dir\n"
else
	work_dir="$1"
	if [ ! -d "$work_dir" ]; then
		echo "错误：指定的工作目录 $work_dir 不存在，请检查输入的目录路径是否正确。"
		exit 1
	fi
	work_dir=$(realpath $work_dir)
	echo -e "工作目录:\n$work_dir\n"
fi

cd $work_dir 

flag=0
checkfile "genome/sequences.fa"
checkfile "genome/genes.gtf"
checkfile "sample.list.txt"
if [ -e "sample.list.txt" ];then
for i in `cat sample.list.txt|tr -d '\r'|grep -v "#"|grep -vP '^$'`
do
checkfile "fq/$i.R1.fq.gz"
checkfile "fq/$i.R2.fq.gz"
done
fi
if [ $flag == 1 ];then
ctime=$(curTime)
echo ""
echo "[ERROR] $ctime 分析无法继续，请修复上述错误后重试！"
exit 1
else
echo -e  "输入文件检查正常\n"
fi

CPU=`getconf _NPROCESSORS_ONLN|xargs -I% echo "% - 1"|bc`
echo "默认CPU核心数目: $CPU"
read -p "回车确认，或直接输入数字修改: " input

if [ -z "$input" ]; then
	echo -ne "确认 $CPU \n\n"
else
	if [[ "$input" =~ ^[0-9]+$ ]]; then
		CPU=$input
	        echo -en "确认 $CPU \n \n"
	else
		echo "输入不合法，请输入回车或者合法的数字进行相应操作"
		exit 1
	fi
fi

MEM=`cat /proc/meminfo|grep MemFree |awk '{print int($2/1024/1024)}'`
echo "默认可用内存: $MEM Gb"
read -p "回车确认，或直接输入数字修改(单位Gb): " input
if [ -z "$input" ]; then
        echo -ne "确认 $MEM Gb\n\n"
else
        if [[ "$input" =~ ^[0-9]+$ ]]; then
            if [ $input -gt $MEM ]; then
                echo "输入的数值大于当前可用内存大小，请重新输入"
                exit 1
            else
                MEM=$input
                echo -e "确认 $MEM Gb\n\n"
            fi
       else
            echo "输入不合法，请输入回车或者合法的数字进行相应操作"
            exit 1
        fi
fi

MEM_PARALLEL=$(echo "$MEM / $CPU" | bc)

export _JAVA_OPTIONS="-Xmx${MEM_PARALLEL}G -Djava.io.tmpdir=$PWD/tmp"
GATKCOMMAND="gatk --java-options \"$_JAVA_OPTIONS\" "

_JAVA_OPTIONS2="-Xmx${MEM}G -Djava.io.tmpdir=$PWD/tmp"
GATKCOMMAND2="gatk --java-options \"$_JAVA_OPTIONS2\" "

if [ ! -d log ];then
mkdir log
fi
if [ -f log/stderr.log ];then
rm log/stderr.log
fi
if [ -f log/stdout.log ];then
rm log/stdout.log
fi

function runordie()
{
local CMD="$*"
ctime=$(curTime)
echo ""
echo "$ctime:开始运行：$CMD"
printf "\n[COMMAND] $ctime $CMD\n" >>log/stderr.log
printf "\n[COMMAND] $ctime $CMD:\n" >>log/stdout.log
echo "$CMD 2>>log/stderr.log >>log/stdout.log"|bash
if [ $? != 0 ];then
ctime=$(curTime)
printf "\n\n[ERROR] $ctime:下列命令运行错误，详情见日志(log)文件夹：\n"
echo "$CMD"
echo ""
exit 1
fi
ctime=$(curTime)
echo "$ctime: 运行结束：$CMD"
echo ""
}
function seqrun()
{
local CMD="bash $1"
ctime=$(curTime)
if [ ! -e "$1.ok" ];then
runordie $CMD
touch $1.ok
else
ctime=$(curTime)
echo "$ctime: 跳过已完成步骤: $1 "
fi
}
function parallelrun()
{
local CMD="parallel -j $CPU <$1"
ctime=$(curTime)
if [ ! -e "$1.ok" ];then
runordie $CMD
touch $1.ok
else
ctime=$(curTime)
echo "$ctime: 跳过已完成步骤: $1 "
fi
}
if [ ! -e ~/.parallel ];then
mkdir ~/.parallel
if [ ! -e ~/.parallel/will-cite ];then
touch ~/.parallel/will-cite
fi
fi
if [ ! -e commands ];then
mkdir commands
mkdir commands/1.mapping
mkdir commands/2.SNP
fi
if [ ! -e genome/snpEffectPredictor.bin ];then
cmd="snpEff build -Xmx${MEM}M -configOption genome.genome=genome -dataDir $PWD genome -v -noCheckProtein -noCheckCds -noLog -nodownload"
runordie $cmd
fi
if [ ! -e genome/sequences.fa.bwt ];then
cmd="bwa index $PWD/genome/sequences.fa"
runordie $cmd
fi
if [ ! -e genome/sequences.fa.fai ];then
cmd="samtools faidx $PWD/genome/sequences.fa"
runordie $cmd
fi
if [ ! -e genome/sequences.dict ];then
cmd="gatk CreateSequenceDictionary -R $PWD/genome/sequences.fa "
runordie $cmd
fi
if [ ! -e 1.mapping ];then
mkdir 1.mapping
fi
if [ ! -e 1.mapping/MarkDup ];then
mkdir 1.mapping/MarkDup
fi
if [ -e commands/1.mapping/s1.map.sh ];then
rm commands/1.mapping/s1.map.sh
fi
if [ -e commands/1.mapping/s2.MarkDup.sh ];then
rm commands/1.mapping/s2.MarkDup.sh
fi
for i in `cat sample.list.txt|grep -v "#" `
do
echo "bwa mem $PWD/genome/sequences.fa $PWD/fq/$i.R1.fq.gz $PWD/fq/$i.R2.fq.gz -M -t $CPU -R \"@RG\tID:$i\tLB:$i\tPL:ILLUMINA\tSM:$i\" | samtools sort -@ $CPU >$PWD/1.mapping/$i.bam && samtools stats $PWD/1.mapping/$i.bam >$PWD/1.mapping/$i.stat.txt" >>commands/1.mapping/s1.map.sh
echo "$GATKCOMMAND MarkDuplicates -I $PWD/1.mapping/$i.bam -O $PWD/1.mapping/MarkDup/$i.MarkDup.bam -M $PWD/1.mapping/MarkDup/$i.markdup_metrics.txt && samtools index $PWD/1.mapping/MarkDup/$i.MarkDup.bam " >>commands/1.mapping/s3.MarkDup.sh;
done
echo "multiqc -n $PWD/1.mapping/mapStat  --no-data-dir $PWD/1.mapping" >commands/1.mapping/s2.mapstat.sh;
if [ ! -e 2.SNP ];then
mkdir 2.SNP
fi
if [ ! -e 2.SNP/1.GVCF ];then
mkdir 2.SNP/1.GVCF
fi
if [ ! -e 2.SNP/2.cohort ];then
mkdir 2.SNP/2.cohort
fi
if [ ! -e 2.SNP/3.filt ];then
mkdir 2.SNP/3.filt
fi
if [ ! -e 2.SNP/4.anno ];then
mkdir 2.SNP/4.anno
fi
if [ ! -e 2.SNP/5.varTable ];then
mkdir 2.SNP/5.varTable
fi
if [ -e commands/2.SNP/s1.HC.sh ];then
rm commands/2.SNP/s1.HC.sh
fi
if [ -e commands/2.SNP/s2.CombineGVCFs.sh ];then
rm commands/2.SNP/s2.CombineGVCFs.sh
fi
if [ -e commands/2.SNP/s3.GenotypeGVCF.sh ];then
rm commands/2.SNP/s3.GenotypeGVCF.sh
fi
if [ -e commands/2.SNP/s4.CombineVCFs.sh ];then
rm commands/2.SNP/s4.CombineVCFs.sh
fi
if [ -e commands/2.SNP/s5.Select.sh ];then
rm 2.SNP/s5.Select.sh
fi
if [ -e commands/2.SNP/s3.GenotypeGVCF.sh ];then
rm commands/2.SNP/s3.GenotypeGVCF.sh
fi
for i in `cat sample.list.txt|grep -v "#"`
do
for j in `cut -f1 genome/sequences.fa.fai`
do
echo "$GATKCOMMAND HaplotypeCaller -R $PWD/genome/sequences.fa -I $PWD/1.mapping/MarkDup/$i.MarkDup.bam -O $PWD/2.SNP/1.GVCF/$i.$j.gvcf.gz --emit-ref-confidence GVCF --do-not-run-physical-phasing -L $j -stand-call-conf 30 " >>commands/2.SNP/s1.HC.sh
done
done
for j in `cut -f1 genome/sequences.fa.fai`
do
printf "$GATKCOMMAND CombineGVCFs -R $PWD/genome/sequences.fa -O $PWD/2.SNP/2.cohort/$j.g.vcf.gz " >>commands/2.SNP/s2.CombineGVCFs.sh
for i in `cat sample.list.txt|grep -v "#"`
do
printf " -V $PWD/2.SNP/1.GVCF/$i.$j.gvcf.gz " >>commands/2.SNP/s2.CombineGVCFs.sh
done
printf "\n" >>commands/2.SNP/s2.CombineGVCFs.sh
done
for j in `cut -f1 genome/sequences.fa.fai`
do
echo "$GATKCOMMAND GenotypeGVCFs -R $PWD/genome/sequences.fa -V $PWD/2.SNP/2.cohort/$j.g.vcf.gz -O $PWD/2.SNP/2.cohort/$j.vcf.gz " >>commands/2.SNP/s3.GenotypeGVCF.sh
done

echo -n "bcftools concat --no-version -a -d all -Oz -o $PWD/2.SNP/3.filt/raw.vcf.gz" >commands/2.SNP/s4.CombineVCFs.sh
for j in `cut -f1 genome/sequences.fa.fai`
do
    echo -n " $PWD/2.SNP/2.cohort/$j.vcf.gz "
done >>commands/2.SNP/s4.CombineVCFs.sh
echo ""  >>commands/2.SNP/s4.CombineVCFs.sh

cat >commands/2.SNP/s5.Filter.sh  <<EOF
bcftools view --no-version -V indels $PWD/2.SNP/3.filt/raw.vcf.gz |bcftools filter --no-version -s 'PASS' -i 'QD>=2 && QUAL>=30 && SOR<=3 && FS<=60 && MQ>=40 && MQRankSum>=-12.5 && ReadPosRankSum>=-8' |bcftools annotate --no-version --set-id '%CHROM\__%POS'  -W  -Oz -o $PWD/2.SNP/3.filt/filtered.snp.vcf.gz 
bcftools view --no-version -V snps   $PWD/2.SNP/3.filt/raw.vcf.gz |bcftools filter --no-version -s 'PASS' -i 'QD>=2 && QUAL>=30 && FS<=200 && ReadPosRankSum>=-20' |bcftools annotate --no-version --set-id '%CHROM\__%POS' -W  -Oz -o $PWD/2.SNP/3.filt/filtered.indel.vcf.gz
EOF
echo "bcftools concat -a -d all --no-version $PWD/2.SNP/3.filt/filtered.snp.vcf.gz $PWD/2.SNP/3.filt/filtered.indel.vcf.gz -Oz  -o  $PWD/2.SNP/3.filt/filtered.all.vcf.gz " >commands/2.SNP/s6.merge.sh
echo "snpEff -Xmx${MEM}M eff -dataDir $PWD -configOption genome.genome=\"genome\" genome $PWD/2.SNP/3.filt/filtered.all.vcf.gz -ud 3000 -noLog -noStats -geneId -o gatk |bcftools view --no-version -Oz -o $PWD/2.SNP/4.anno/all.Variants.anno.vcf.gz ">commands/2.SNP/s7.anno.sh

echo "bcftools view -V indels $PWD/2.SNP/4.anno/all.Variants.anno.vcf.gz --no-version  -Oz -o $PWD/2.SNP/4.anno/snp.anno.vcf.gz " >commands/2.SNP/s8.select.sh
echo "bcftools view -V snps $PWD/2.SNP/4.anno/all.Variants.anno.vcf.gz --no-version  -Oz -o $PWD/2.SNP/4.anno/indel.anno.vcf.gz " >>commands/2.SNP/s8.select.sh


echo "bcftools query -f \"%CHROM\\t%POS\\t%REF\\t%ALT\\t%EFF[\\t%TGT]\\n\"   $PWD/2.SNP/4.anno/indel.anno.vcf.gz  -H |sed '1s/\[[0-9]\+\]//g' >$PWD/2.SNP/5.varTable/indels.table.tsv " >commands/2.SNP/s9.makeTable.sh
echo "bcftools query -f \"%CHROM\\t%POS\\t%REF\\t%ALT\\t%EFF[\\t%TGT]\\n\"   $PWD/2.SNP/4.anno/snp.anno.vcf.gz    -H |sed '1s/\[[0-9]\+\]//g' >$PWD/2.SNP/5.varTable/snps.table.tsv "   >>commands/2.SNP/s9.makeTable.sh



seqrun "commands/1.mapping/s1.map.sh"
seqrun "commands/1.mapping/s2.mapstat.sh"
parallelrun "commands/1.mapping/s3.MarkDup.sh"
parallelrun "commands/2.SNP/s1.HC.sh"
parallelrun "commands/2.SNP/s2.CombineGVCFs.sh"
parallelrun "commands/2.SNP/s3.GenotypeGVCF.sh"
parallelrun "commands/2.SNP/s4.CombineVCFs.sh"
parallelrun "commands/2.SNP/s5.Filter.sh"
parallelrun "commands/2.SNP/s6.merge.sh"
seqrun      "commands/2.SNP/s7.anno.sh"
parallelrun "commands/2.SNP/s8.select.sh"
parallelrun "commands/2.SNP/s9.makeTable.sh"

echo "所有分析已完成!"

rm -rf $PWD/tmp
